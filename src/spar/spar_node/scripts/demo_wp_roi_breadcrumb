#!/usr/bin/env python3

import sys
from math import *

import rospy
import actionlib
from actionlib_msgs.msg import GoalStatus

from geometry_msgs.msg import Point, PoseStamped

from spar_msgs.msg import FlightMotionAction, FlightMotionGoal

from std_msgs.msg import Bool

# Breadcrumb service imports
from breadcrumb.srv import RequestPath
from breadcrumb.srv import RequestPathRequest


# This is getting a bit more complicated now, so we'll put our information in
# a class to keep track of all of our variables. This is not so much different
# to the previous methods, other than the fact that the class will operate
# within itself.
# i.e. it will have it's own publishers, subscribers, etc., that
# will call it's own functions as callbacks, etc.
class Guidance():
    def __init__(self, waypoints):
        # Make sure we have a valid waypoint list
        if not self.check_waypoints(waypoints):
            raise ValueError("Invalid waypoint list input!")

        # Internal counter to see what waypoint we are up to
        self.waypoint_counter = 0

        # Set a flag to indicate that we are doing a specific inspection
        # and that we are not following our waypoint list
        # This will stop our "waypoint is reached" callback from firing
        # during the ROI diversion and taking over our flight!
        self.performing_roi = False

        # Save the input waypoints
        self.waypoints = waypoints

        # Make some space to record down our current location
        self.current_location = Point()

        # Payload deployment publishers
        self.servo_a_pub = rospy.Publisher(
            '/actuator_control/actuator_a',
            Bool,
            queue_size=1
        )

        self.servo_b_pub = rospy.Publisher(
            '/actuator_control/actuator_b',
            Bool,
            queue_size=1
        )

        # Keep track of which payload has been deployed
        self.payload_a_deployed = False
        self.payload_b_deployed = False


        # Set our linear and rotational velocities for the flight
        self.vel_linear = rospy.get_param("~vel_linear", 0.2)
        self.vel_yaw = rospy.get_param("~vel_yaw", 0.2)

        # Set our position and yaw waypoint accuracies
        self.accuracy_pos = rospy.get_param("~acc_pos", 0.1)
        self.accuracy_yaw = rospy.get_param("~acc_yaw", 0.1)

        # Create our action client
        action_ns = rospy.get_param("~action_topic", 'spar/flight')
        self.spar_client = actionlib.SimpleActionClient(
            action_ns,
            FlightMotionAction
        )

        rospy.loginfo("Waiting for spar...")
        self.spar_client.wait_for_server()

        if not rospy.is_shutdown():
            # Good to go, start mission
            rospy.loginfo("Starting waypoint mission")

            # Setup first waypoint segment
            self.send_wp(self.waypoints[0])
            self.waypoint_counter += 1

            # Setup a timer to check if our waypoint has completed at 20 Hz
            self.timer = rospy.Timer(
                rospy.Duration(1.0 / 20.0),
                self.check_waypoint_status
            )

            # Callback to save "current location" such that we can perform and
            # return from a diversion to the correct location.
            self.sub_pose = rospy.Subscriber(
                "~pose",
                PoseStamped,
                self.callback_pose
            )

            # Subscriber to catch "ROI" diversion commands
            self.sub_roi = rospy.Subscriber(
                "~roi",
                PoseStamped,
                self.callback_inspect_roi
            )

            # If shutdown is issued (e.g. CTRL-C), cancel the current mission
            # before rospy shuts down.
            rospy.on_shutdown(lambda: self.shutdown())


    # This function will check if a list of waypoints is in the format we expect
    def check_waypoints(self, wps):
        # Make sure waypoints are a list
        if not isinstance(wps, list):
            rospy.logwarn("Waypoints are not a list")
            return False

        # Make sure we have at least one waypoint
        if len(wps) < 1:
            rospy.logwarn("Waypoints list is empty")
            return False

        # Check each waypoint
        for i in range(len(wps)):
            if not self.check_waypoint(wps[i]):
                rospy.logwarn("Waypoint %i did not pass check" % (i + 1))
                return False

        return True


    # This function checks whether one waypoint has the expected format
    def check_waypoint(self, wp):
        # Make sure each waypoint is a list
        if not isinstance(wp, list):
            rospy.logwarn("Waypoint is not a list of coordinates")
            return False

        # Make sure each waypoint has four values
        if len(wp) != 4:
            rospy.logwarn(
                "Waypoint has an invalid length (must be X/Y/Z/Yaw)"
            )
            return False

        return True


    # This function will make sure we shut down the node as safely as possible
    def shutdown(self):
        # Only unregister objects if they were created
        if hasattr(self, "timer"):
            self.timer.shutdown()

        if hasattr(self, "sub_pose"):
            self.sub_pose.unregister()

        if hasattr(self, "sub_roi"):
            self.sub_roi.unregister()

        self.spar_client.cancel_goal()
        rospy.loginfo("Guidance stopped")


    # This function receives the current pose of the UAV constantly
    def callback_pose(self, msg_in):
        # Store the current position at all times so it can be accessed later
        self.current_location = msg_in.pose.position

    # This function defines the payload deployment process
    def deploy_payload(self):
        # Deploy payload A first
        if not self.payload_a_deployed:
            rospy.loginfo("Deploying Payload A")

            self.servo_a_pub.publish(Bool(data=True))
            rospy.sleep(rospy.Duration(1.0))

            self.payload_a_deployed = True

            rospy.loginfo("Payload A deployed")
            return

        # If A has already been used, deploy B
        if not self.payload_b_deployed:
            rospy.loginfo("Deploying Payload B")

            self.servo_b_pub.publish(Bool(data=True))
            rospy.sleep(rospy.Duration(1.0))

            self.payload_b_deployed = True

            rospy.loginfo("Payload B deployed")
            return

        rospy.logwarn("No payloads remaining!")

    # This function fires whenever an ROI pose message is sent.
    # It is also responsible for handling the ROI inspection task.
    def callback_inspect_roi(self, msg_in):
        # ignore a second ROI while one diversion is already running
        if self.performing_roi:
            rospy.logwarn(
                "Ignoring ROI message because a diversion is already running"
            )
            return

        # Set our flag that we are performing the diversion
        self.performing_roi = True

        rospy.loginfo("Starting diversion to ROI...")

        # Cancel the current goal, if there is one
        self.spar_client.cancel_goal()

        
        #Get target X/Y from the received ROI message 
        target_x = msg_in.pose.position.x
        target_y = msg_in.pose.position.y


       # stay above target
        # AUT/NAV controls the required flight altitude.
        target_above = [
            target_x,
            target_y,
            2,
            0.0
        ]

        # Same X/Y as the target, but descend vertically to 0.5 m.
        target_deploy = [
            target_x,
            target_y,
            0.5,
            0.0
        ]



        # Copy the current position into a return waypoint
        rwp = [
            self.current_location.x,
            self.current_location.y,
            self.current_location.z,
            0.0
        ]
        #First fly ABOVE the detected target 
        rospy.loginfo("Flying above detected target at 2 m...")

        self.send_wp(target_above)
        self.spar_client.wait_for_result()

        if self.spar_client.get_state() != GoalStatus.SUCCEEDED:
            rospy.logerr("Failed to reach target")
            rospy.signal_shutdown("cancelled")
            return

        rospy.loginfo("Reached position above target!")

        #Descend vertically to 0.5 m 

        rospy.loginfo("Descending to payload deployment altitude...")

        self.send_wp(target_deploy)
        self.spar_client.wait_for_result()

        if self.spar_client.get_state() != GoalStatus.SUCCEEDED:
            rospy.logerr("Failed to reach deployment altitude")
            rospy.signal_shutdown("cancelled")
            return

        rospy.loginfo("Reached deployment altitude: 0.5 m")

        # PAYLOAD DEPLOYMENT
        rospy.loginfo("Deployment position reached")

        self.deploy_payload()

        rospy.loginfo("Payload deployment sequence finished")

        #  Climb vertically back to 2 m 

        rospy.loginfo("Climbing back to search altitude...")

        self.send_wp(target_above)
        self.spar_client.wait_for_result()

        if self.spar_client.get_state() != GoalStatus.SUCCEEDED:
            rospy.logerr("Failed to climb back to search altitude")
            rospy.signal_shutdown("cancelled")
            return

        rospy.loginfo("Returned to search altitude: 2 m")



       
        # RETURN-TO-MISSION
        
        rospy.loginfo("Returning to flight plan...")

        # Return to the point where the diversion began
        self.send_wp(rwp)
        self.spar_client.wait_for_result()

        if self.spar_client.get_state() != GoalStatus.SUCCEEDED:
            rospy.logerr("Return waypoint failed")
            rospy.signal_shutdown("cancelled")
            return

        # waypoint_counter represents the next waypoint.
        # waypoint_counter - 1 represents the interrupted waypoint.
        rospy.loginfo(
            "Resuming flight plan from waypoint %i!",
            self.waypoint_counter
        )

        self.send_wp(self.waypoints[self.waypoint_counter - 1])

        # Allow the timer to take control of waypoint progression again
        self.performing_roi = False

        rospy.loginfo("Reached diversion ROI!")



    # Convenience function to send a new waypoint
    def send_wp(self, wp):
        # Make sure the waypoint is valid before continuing
        if not self.check_waypoint(wp):
            raise ValueError("Invalid waypoint input!")

        # Build the flight goal
        goal = FlightMotionGoal()
        goal.motion = FlightMotionGoal.MOTION_GOTO

        goal.position.x = wp[0]
        goal.position.y = wp[1]
        goal.position.z = wp[2]

        goal.yaw = wp[3]

        goal.velocity_vertical = self.vel_linear
        goal.velocity_horizontal = self.vel_linear
        goal.yawrate = self.vel_yaw

        goal.wait_for_convergence = True
        goal.position_radius = self.accuracy_pos
        goal.yaw_range = self.accuracy_yaw

        # Do not wait here. The timer checks normal waypoints, while the ROI
        # callback waits directly during a diversion.
        self.spar_client.send_goal(goal)


    # This function fires whenever we receive a timer event from rospy.Timer().
    # It checks whether a waypoint has been reached and, if so, sends the next.
    def check_waypoint_status(self, timer_event):
        # During an ROI diversion, this function must not take control
        if self.performing_roi:
            return

        state = self.spar_client.get_state()

        if state == GoalStatus.SUCCEEDED:
            rospy.loginfo(
                "Reached waypoint %i!",
                self.waypoint_counter
            )

            if self.waypoint_counter < len(self.waypoints):
                self.send_wp(self.waypoints[self.waypoint_counter])
                self.waypoint_counter += 1
            else:
                rospy.loginfo("Mission complete!")
                rospy.signal_shutdown("complete")

        elif state in (
            GoalStatus.PREEMPTED,
            GoalStatus.ABORTED,
            GoalStatus.REJECTED
        ):
            rospy.loginfo("Mission cancelled!")
            rospy.signal_shutdown("cancelled")


def main(args):
    # Initialise ROS
    rospy.init_node('guidance')

    # ---------------------------------------------------------------------
    # HIGH-LEVEL WAYPOINTS
    #
    # These are the main points that describe the required path.
    # Breadcrumb will calculate  low-level waypoints between them.
    #
    # Format: [X, Y, Z, Yaw]
    #
    # ---------------------------------------------------------------------
    waypoints = [
        [ 0.0,  0.0, 2, 0.0],

	[ 3.8, -2.3, 2, 0.0],
    [-1.9, -2.3, 2, 0.0],
    [0.0, -2.3, 2, 0.0],
    [1.9, -2.3, 2, 0.0],
    [1.9, -2.3, 2, 0.0],

    [ 3.8, -1.3, 2, 0.0],
    [-1.9, -1.3, 2, 0.0],
    [0.0, -1.3, 2, 0.0],
    [1.9, -1.3, 2, 0.0],
    [1.9, -1.3, 2, 0.0],

    [ 3.8, 0.0, 2, 0.0],
    [-1.9, 0.0, 2, 0.0],
    [0.0, 0.0, 2, 0.0],
    [1.9, 0.0, 2, 0.0],
    [1.9, 0.0, 2, 0.0],

    [ 3.8, 1.3, 2, 0.0],
    [-1.9, 1.3, 2, 0.0],
    [0.0,  1.3, 2, 0.0],
    [1.9,  1.3, 2, 0.0],
    [1.9,  1.3, 2, 0.0],

    [ 3.8, 2.3, 2, 0.0],
    [-1.9, 2.3, 2, 0.0],
    [0.0,  2.3, 2, 0.0],
    [1.9,  2.3, 2, 0.0],
    [1.9,  2.3, 2, 0.0],

    [ 0.0,  0.0, 2, 0.0]
    ]

    # ---------------------------------------------------------------------
    # BREADCRUMB SETUP
    # ---------------------------------------------------------------------
    rospy.loginfo("Waiting for Breadcrumb service...")
    rospy.wait_for_service('/breadcrumb/request_path')

    srvc_bc = rospy.ServiceProxy(
        '/breadcrumb/request_path',
        RequestPath
    )

    # This list will hold every low-level waypoint returned by Breadcrumb.
    # It will later be passed to Guidance 
    wps = []

    # ---------------------------------------------------------------------
    # MULTIPLE-WAYPOINT BREADCRUMB LOOP
    #
    # This follows the multiple-waypoint example in the guide.
    # It plans:
    #     waypoint 0 -> waypoint 1
    #     waypoint 1 -> waypoint 2
    #     and so on.
    # ---------------------------------------------------------------------
    for segment_index in range(len(waypoints) - 1):
        req = RequestPathRequest()

        req.start.x = waypoints[segment_index][0]
        req.start.y = waypoints[segment_index][1]
        req.start.z = waypoints[segment_index][2]

        req.end.x = waypoints[segment_index + 1][0]
        req.end.y = waypoints[segment_index + 1][1]
        req.end.z = waypoints[segment_index + 1][2]

        rospy.loginfo(
            "Requesting Breadcrumb segment %i:",
            segment_index + 1
        )

        rospy.loginfo(
            "[%0.2f;%0.2f;%0.2f] => [%0.2f;%0.2f;%0.2f]",
            req.start.x,
            req.start.y,
            req.start.z,
            req.end.x,
            req.end.y,
            req.end.z
        )

        try:
            res = srvc_bc(req)
        except rospy.ServiceException as error:
            rospy.logerr(
                "Breadcrumb service call failed for segment %i: %s",
                segment_index + 1,
                str(error)
            )
            return

        # Breadcrumb returns an empty vector if no solution was found
        if len(res.path.poses) == 0:
            rospy.logerr(
                "Solution not found for segment %i",
                segment_index + 1
            )
            return

        rospy.loginfo(
            "Segment %i returned %i poses",
            segment_index + 1,
            len(res.path.poses)
        )

        # Store the returned poses in the [X, Y, Z, Yaw] format expected
        # by the original Guidance class.
        for pose_index in range(len(res.path.poses)):
            # Every segment after the first normally begins at the
            # previous segment's endpoint. Skip that first repeated pose.
            if segment_index > 0 and pose_index == 0:
                continue

            pose = res.path.poses[pose_index]

            # Use the yaw of the segment's destination waypoint
            yaw = waypoints[segment_index + 1][3]

            wps.append([
                pose.position.x,
                pose.position.y,
                pose.position.z,
                yaw
            ])

            rospy.loginfo(
                "    [%0.2f;%0.2f;%0.2f]",
                pose.position.x,
                pose.position.y,
                pose.position.z
            )

    if len(wps) == 0:
        rospy.logerr("Breadcrumb produced an empty final waypoint list")
        return

    rospy.loginfo(
        "Breadcrumb planning complete: %i low-level waypoints",
        len(wps)
    )

    # ---------------------------------------------------------------------
    # ORIGINAL GUIDANCE HAND-OFF
    #
    # The original demo used:
    #     guide = Guidance(wps)
    #
    # We keep that exact design. The only difference is that wps now comes
    # from Breadcrumb rather than a hard-coded list.
    # ---------------------------------------------------------------------
    guide = Guidance(wps)

    # Spin!
    rospy.spin()


if __name__ == '__main__':
    try:
        main(sys.argv)
    except rospy.ROSInterruptException:
        pass

    print('')